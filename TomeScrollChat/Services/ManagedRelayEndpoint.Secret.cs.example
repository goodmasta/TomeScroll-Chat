// Copy this file to "ManagedRelayEndpoint.Secret.cs" (gitignored, right next to this one) and fill in
// the real address to make the "TomeScroll Cloud" relay option available in a local build. Not needed
// for anything else - self-hosted relay mode and every other feature work fine without it.

namespace TomeScrollChat.Services;

public static partial class ManagedRelayEndpoint
{
    static partial void TryGetSecretUrl(ref string? url) => url = "wss://your-relay-domain-here/relay";
}
