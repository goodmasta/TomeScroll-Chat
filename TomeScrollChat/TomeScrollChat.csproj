<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <Description>Полная замена внутриигрового чата: гибкие вкладки, откреп в отдельные окна, отдельные окна для личных сообщений, кликабельные ссылки, эмодзи BTTV/7TV, история на диске.</Description>
    <PackageProjectUrl>https://github.com/goodmasta/TomeScroll-Chat</PackageProjectUrl>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <RootNamespace>TomeScrollChat</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <!-- Bundled default notification sound (see Services.NotificationSoundService) - embedded directly
       in the assembly rather than shipped as a loose file next to the DLL, so it's guaranteed present
       regardless of how the plugin is packaged/installed (dev-plugin bin folder, or the zip
       Dalamud.NET.Sdk builds for the custom-repo release). Extracted to disk once at startup since
       PlaySound (winmm.dll) needs a real file path, not an in-memory stream. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\DefaultNotification.wav" />
    <EmbeddedResource Include="Assets\DefaultWhisperNotification.wav" />
  </ItemGroup>

  <!-- Embeds the current git commit hash into the assembly via AssemblyMetadataAttribute, read back
       by Plugin.PrintVersion ("/tomescrollc version"). <Version> above is hand-set and rarely bumped
       between commits, so on its own it can't answer "which commit is this build" - the commit hash
       always can, since it changes on every commit regardless of whether Version was touched. Falls
       back to "unknown" (not a build failure) if git isn't on PATH or this isn't a git checkout. -->
  <Target Name="SetGitCommitHash" BeforeTargets="GenerateAssemblyInfo" AfterTargets="PrepareForBuild">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" WorkingDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHashOutput" />
      <Output TaskParameter="ExitCode" PropertyName="GitCommitHashExitCode" />
    </Exec>
    <PropertyGroup>
      <GitCommitHash Condition="'$(GitCommitHashExitCode)' == '0' AND '$(GitCommitHashOutput)' != ''">$(GitCommitHashOutput)</GitCommitHash>
      <GitCommitHash Condition="'$(GitCommitHash)' == ''">unknown</GitCommitHash>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommitHash</_Parameter1>
        <_Parameter2>$(GitCommitHash)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
